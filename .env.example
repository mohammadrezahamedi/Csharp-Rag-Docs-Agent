# Copy this file to ".env.local" and fill in your own values. ".env.local" is git-ignored.
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Or use local Ollama instead: LLM_PROVIDER=ollama
